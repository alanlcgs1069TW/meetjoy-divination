# 複製成 .env.local 後填入你自己的 Supabase 專案資訊
# .env.local 已列入 .gitignore，不會被 commit

# Supabase 專案 URL（Project Settings → API → Project URL）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key（Project Settings → API → anon public）
# 這把 key 可公開，實際權限由 Row Level Security 控制
VITE_SUPABASE_ANON_KEY=your-anon-key

# 密碼重設信的返回網址；本機開發可留空，會自動用 window.location.origin
VITE_SITE_URL=
